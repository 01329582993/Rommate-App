{
  "name": "rommate-app",
  "private": true,
  "scripts": {
    "start": "node scripts/start-dev.js",
    "dev": "node scripts/start-dev.js",
    "all": "node scripts/start-dev.js",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run start -- --clear",
